feat(brand): original launcher, notification, account and splash icons

Replaces every Telegram paper-plane icon that the app shows with an
original glyph: a white speech bubble with three dots on violet.
All files are in TMessagesProj_App/src/main/res, where Android resource
merging lets them override the library resources with the same names:

- mipmap-anydpi-v26: adaptive launcher icons, including the alternative
  launcher icons (icon_2 to icon_6) and the monochrome layer.
- mipmap-anydpi: the same icons for Android 5.0 to 7.1, and the icon
  foregrounds that the in-app icon picker shows.
- drawable-anydpi/notification: status bar icon.
- drawable-anydpi/ic_launcher_dr: account and call notification icon.
- drawable/tg_splash_320: Android 12+ splash icon.
- drawable-anydpi/intro_tg_plane: the intro animation draws the chat
  bubble texture instead of the plane.
>>> create TMessagesProj_App/src/main/res/values/myclient_colors.xml
>>> text
<?xml version="1.0" encoding="utf-8"?>
<!-- Unofficial client (myclient): colors of the original app icon. -->
<resources>
    <color name="myclient_icon_background">#5B3FD9</color>
    <color name="myclient_icon_foreground">#FFFFFF</color>
</resources>
>>> create TMessagesProj_App/src/main/res/drawable/myclient_icon_foreground.xml
>>> text
<?xml version="1.0" encoding="utf-8"?>
<!-- Unofficial client (myclient): original icon glyph, a speech bubble with three dots. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/myclient_icon_foreground"
        android:pathData="M44,34H64A14,14 0 0 1 78,48V56A14,14 0 0 1 64,70H44L33,78L35,67A14,14 0 0 1 30,56V48A14,14 0 0 1 44,34ZM38,52A4,4 0 1 0 46,52A4,4 0 1 0 38,52ZM50,52A4,4 0 1 0 58,52A4,4 0 1 0 50,52ZM62,52A4,4 0 1 0 70,52A4,4 0 1 0 62,52Z" />
</vector>
>>> create TMessagesProj_App/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
>>> text
<?xml version="1.0" encoding="utf-8"?>
<!-- Unofficial client (myclient): original app icon. Replaces the Telegram logo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/myclient_icon_background" />
    <foreground android:drawable="@drawable/myclient_icon_foreground" />
    <monochrome android:drawable="@drawable/myclient_icon_foreground" />
</adaptive-icon>
